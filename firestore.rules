rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Core Philosophy: This ruleset enforces a hybrid security model. User-private data is governed
     * by a strict user-ownership model. Shared client data uses a role-based access control (RBAC)
     * system managed through a `members` map. A global "admin" role exists that provides super-user
     * access to all data for management purposes.
     *
     * Data Structure: User-private data is under `/users/{userId}`. Shared client data is under
     * `/clients/{clientId}`. Global data like `/categories` and `/alerts` is at the top level.
     * Admin users are defined in a top-level `/admins` collection.
     *
     * Key Security Decisions:
     * - User data is private to the owner, but accessible to admins.
     * - Admins have read/write access to all user and client data to manage the application.
     * - The `/admins` collection is only writable by other admins, creating a chain of trust.
     *   The first admin must be added manually via the Firebase Console.
     * - Client data access is managed by a `members` map, but admins can also access it.
     * - Denormalization of the `members` map is used for performance, avoiding `get()` calls.
     * - Listing users is only allowed for admins to protect user privacy.
     */

    // --------------------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks for ownership on an existing document. Used for safe updates and deletes.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * Checks if the current user is a designated admin.
     * This performs a single read and its result is automatically cached per request.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * Checks if the authenticated user is a member of a document.
     * Assumes the document data has a 'members' map: `{ 'uid': 'role' }`.
     */
    function isMember(docData) {
      return isSignedIn() && request.auth.uid in docData.members;
    }

    /**
     * Checks for membership on an existing document for safe updates and deletes.
     */
    function isExistingMember(docData) {
      return isMember(docData) && resource != null;
    }

    /**
     * Checks if a user is a member of the parent client document.
     * This performs a single `get` operation and should be used for list/create rules.
     */
    function isParentClientMember(clientId) {
      let clientData = get(/databases/$(database)/documents/clients/$(clientId)).data;
      return isSignedIn() && request.auth.uid in clientData.members;
    }

    // --------------------------------------------------------------------------------
    // Admin Data
    // --------------------------------------------------------------------------------

    /**
     * @description Collection to manage admin users. Only other admins can add or remove admins.
     * @path /admins/{userId}
     * @allow (write) An existing admin creating a new document in '/admins/'.
     * @deny (write) A non-admin user trying to make themselves an admin.
     * @principle Secures administrative control to a trusted group of users.
     */
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }


    // --------------------------------------------------------------------------------
    // User Data
    // --------------------------------------------------------------------------------

    /**
     * @description A user can create their own profile. Only they or an admin can read/modify it.
     * @path /users/{userId}
     * @allow (get) Admin reading '/users/user_abc'.
     * @deny (list) Non-admin trying to list all users.
     * @principle Admins have oversight, while user privacy is maintained from other users.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Only admins can list users
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) || isAdmin()) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description A user can manage their own private tasks. Admins have full access.
     * @path /users/{userId}/tasks/{taskId}
     * @principle Enforces ownership but allows admin intervention.
     */
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    /**
     * @description A user can manage their own cash book. Admins have full access.
     * @path /users/{userId}/cashbooks/{cashbookId}
     * @principle Enforces ownership but allows admin intervention.
     */
    match /users/{userId}/cashbooks/{cashbookId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    /**
     * @description A user can manage their own private expenses. Admins have full access.
     * @path /users/{userId}/expenses/{expenseId}
     * @principle Enforces ownership but allows admin intervention.
     */
    match /users/{userId}/expenses/{expenseId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    /**
     * @description A user can manage their own private income records. Admins have full access.
     * @path /users/{userId}/incomes/{incomeId}
     * @principle Enforces ownership but allows admin intervention.
     */
    match /users/{userId}/incomes/{incomeId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --------------------------------------------------------------------------------
    // Shared Client Data
    // --------------------------------------------------------------------------------

    /**
     * @description Client documents are shared via a `members` map. Admins have override access.
     * @path /clients/{clientId}
     * @principle Implements collaborative access with an admin override.
     */
    match /clients/{clientId} {
      allow get: if isMember(resource.data) || isAdmin();
      allow list: if isSignedIn(); // Client must constrain query: .where(`members.${auth.uid}`, 'in', ...) or be an admin
      allow create: if isSignedIn() && isMember(request.resource.data) || isAdmin();
      allow update: if isExistingMember(resource.data) || isAdmin();
      allow delete: if (isExistingMember(resource.data) && resource.data.members[request.auth.uid] == 'owner') || isAdmin();
    }

    /**
     * @description Client tasks are accessible to client members or admins.
     * @path /clients/{clientId}/tasks/{taskId}
     * @principle Uses denormalized auth data but allows admin override.
     */
    match /clients/{clientId}/tasks/{taskId} {
      allow get: if isMember(resource.data) || isAdmin();
      allow list: if isParentClientMember(clientId) || isAdmin();
      allow create: if (isParentClientMember(clientId) && request.resource.data.clientId == clientId) || isAdmin();
      allow update: if (isExistingMember(resource.data) && request.resource.data.clientId == resource.data.clientId) || isAdmin();
      allow delete: if isExistingMember(resource.data) || isAdmin();
    }

    /**
     * @description Client payments are accessible to client members or admins.
     * @path /clients/{clientId}/payments/{paymentId}
     * @principle Uses denormalized auth data but allows admin override.
     */
    match /clients/{clientId}/payments/{paymentId} {
      allow get: if isMember(resource.data) || isAdmin();
      allow list: if isParentClientMember(clientId) || isAdmin();
      allow create: if (isParentClientMember(clientId) && request.resource.data.clientId == clientId) || isAdmin();
      allow update: if (isExistingMember(resource.data) && request.resource.data.clientId == resource.data.clientId) || isAdmin();
      allow delete: if isExistingMember(resource.data) || isAdmin();
    }

    /**
     * @description Client income records are accessible to client members or admins.
     * @path /clients/{clientId}/incomes/{incomeId}
     * @principle Uses denormalized auth data but allows admin override.
     */
    match /clients/{clientId}/incomes/{incomeId} {
      allow get: if isMember(resource.data) || isAdmin();
      allow list: if isParentClientMember(clientId) || isAdmin();
      allow create: if (isParentClientMember(clientId) && request.resource.data.clientId == clientId) || isAdmin();
      allow update: if (isExistingMember(resource.data) && request.resource.data.clientId == resource.data.clientId) || isAdmin();
      allow delete: if isExistingMember(resource.data) || isAdmin();
    }


    // --------------------------------------------------------------------------------
    // Global Data
    // --------------------------------------------------------------------------------

    /**
     * @description Categories are global and readable by any authenticated user, but not writable by clients.
     * @path /categories/{categoryId}
     * @principle Secures global data as read-only for clients, but allows admin modification.
     */
    match /categories/{categoryId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    /**
     * @description Alerts are readable by any authenticated user, but not writable from the client. Admins can manage them.
     * @path /alerts/{alertId}
     * @principle Secures global data as read-only for clients, assuming writes are handled by a trusted backend or an admin.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

  }
}
    